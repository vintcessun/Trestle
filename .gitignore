# 凭据 —— 绝不入库
config/secrets.toml
*.pem
*.key

# 你自己的机器清单 —— 也绝不入库。
# 真实 IP + 端口 + 用户名 + 工作目录凑一起就是一份可以直接照着连的清单，
# 缺的只有凭据。样例在 config/trestle.example.toml，复制一份改成你自己的。
config/trestle.toml

!*.example.*

# 安装产物。scripts\install.ps1 生成，里面有配置与凭据的副本。
/dist/

# Rust
/target/
plugins/**/target/
**/*.rs.bk
Cargo.lock.orig

# 插件产物：由 scripts/build-plugins.ps1 生成，不入库
plugins/**/*.wasm
# componentize-py 生成的绑定
plugins/**/wit_world/
plugins/**/componentize_py_async_support/
__pycache__/
*.pyc

# 运行期状态：所有运行期文件都在程序目录下（见 docs/08）
daemon.json
state/
config/state/
logs/
*.log

# 编辑器
.idea/
.vscode/
*.swp
